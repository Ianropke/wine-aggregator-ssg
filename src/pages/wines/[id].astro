---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProConMatrix from '../../components/ProConMatrix.astro';
import VibeBadge from '../../components/VibeBadge.astro';

export async function getStaticPaths() {
  const wines = await getCollection('wines');
  return wines.map(wine => ({
    params: { id: wine.data.id },
    props: { wine },
  }));
}

const { wine } = Astro.props;
const { Content } = await render(wine);

// Marketing Pull-Quote text & Embed HTML
const pullQuote = `VibeWine (${wine.data.points} pts): En flaske med ${wine.data.vibe_category?.toLowerCase() || 'ren'} vibe fra ${wine.data.region} – klar til at skabe den helt rigtige stemning.`;
const embedCode = `<iframe src="https://vibewine.dk/embed/${wine.data.id}" width="100%" height="90" frameborder="0"></iframe>`;

// Bygger JSON-LD schema (Rule 10)
const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": wine.data.title,
  "description": `Vinanmeldelse af ${wine.data.title} fra ${wine.data.region}. QPR: ${wine.data.qpr}.`,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "DKK",
    "price": Math.round(wine.data.price),
    "availability": "https://schema.org/InStock"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": wine.data.points,
      "bestRating": 100
    },
    "author": {
      "@type": "Organization",
      "name": "VibeWine"
    }
  }
};
const pageDescription = `Vinanmeldelse og Vibe Score for ${wine.data.title} (${wine.data.vintage}) fra ${wine.data.region}. Vibe: ${wine.data.vibe_category || 'Kvalitetsvin'}. Score: ${wine.data.points}/100 pts.`;
---

<Layout title={`${wine.data.title} - VibeWine`} description={pageDescription} schema={schema}>
  <article class="max-w-4xl mx-auto bg-white rounded-[2rem] shadow-sm border border-[#FFE4E8] p-8 md:p-16 mb-16 relative overflow-hidden">
    <!-- Decorative gradient orb -->
    <div class="absolute -top-32 -right-32 w-64 h-64 bg-[#FF6B6B] rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>
    <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-[#FF8E53] rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>

    <!-- The VibeBadge Sticker! -->
    <VibeBadge score={wine.data.points} class="absolute top-6 right-6 md:top-10 md:right-10 rotate-12 z-20" />

    <header class="text-center mb-16 relative z-10 pt-4 md:pt-0">
      <div class="flex items-center justify-center gap-3 text-sm font-bold uppercase tracking-widest text-[#FF6B6B] mb-6">
        <span>{wine.data.region}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B6B] opacity-50"></span>
        <span>{wine.data.vintage}</span>
      </div>
      
      <h1 class="text-5xl md:text-7xl font-['Outfit',sans-serif] font-black text-[#111827] mb-12 leading-tight tracking-tight pr-0 md:pr-16">{wine.data.title}</h1>
      
      <div class="flex flex-col md:flex-row justify-between items-center gap-8 md:gap-12 bg-[#FFF9FA] p-8 md:p-12 rounded-3xl border border-[#FFE4E8]">
        <div class="flex-grow text-center md:text-left">
          <div class="prose prose-lg prose-stone prose-headings:font-['Outfit'] prose-headings:font-bold prose-p:text-[#111827] prose-p:font-medium prose-p:text-xl leading-relaxed">
            <Content />
          </div>
        </div>
        <div class="hidden md:block w-px h-24 bg-[#FFE4E8]"></div>
        <div class="flex flex-col gap-6 shrink-0">
          <div class="flex flex-col items-center gap-4">
            <div class="flex gap-8 md:gap-12 items-center justify-center">
              <div class="text-center">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">Pris</p>
                <p class="text-4xl font-black text-[#111827]">{Math.round(wine.data.price)} <span class="text-xl font-medium text-gray-500">kr.</span></p>
                {wine.data.bundle_size && wine.data.bundle_size > 1 && (
                  <p class="text-sm font-medium text-gray-500 mt-1 uppercase tracking-wider text-[10px]">(ved køb af {wine.data.bundle_size} flasker)</p>
                )}
              </div>
            </div>
            <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-black uppercase tracking-wider text-white shadow-lg" style={`background-color: ${wine.data.qpr_color}`}>
              {wine.data.qpr_emoji} {wine.data.qpr_label}
            </span>
            <p class="text-sm text-gray-500 italic text-center">{wine.data.qpr_tagline}</p>
          </div>
          {wine.data.buy_url && wine.data.retailer_name && (
            <a href={wine.data.buy_url} target="_blank" rel="noopener noreferrer" class="w-full text-center bg-[#FF6B6B] hover:bg-[#ff5252] text-white font-bold py-3 px-6 rounded-full transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg flex items-center justify-center gap-2">
              Køb hos {wine.data.retailer_name}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </header>

    <div class="relative z-10">
      <section class="max-w-4xl mx-auto">
        <ProConMatrix pros={wine.data.pros} cons={wine.data.cons} />
      </section>

      <!-- Retailer Toolkit Section (Collapsible & Subtle) -->
      <details class="mt-16 border-t border-[#FFE4E8] pt-8 group no-print">
        <summary class="cursor-pointer flex items-center justify-between text-gray-500 hover:text-[#FF6B6B] transition-colors font-medium text-sm py-2 select-none">
          <span class="flex items-center gap-2">
            <span>🏪</span>
            <span class="font-bold">Forhandler & Partner Værktøjer</span> (Citat, Embed Widget & Halsskilt)
          </span>
          <span class="text-xs uppercase font-bold bg-gray-100 text-gray-600 px-3 py-1 rounded-full group-open:bg-[#FFE4E8] group-open:text-[#FF6B6B] transition-colors">
            Åbn Værktøjer &darr;
          </span>
        </summary>

        <div class="mt-6 pt-4">
          <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#FF6B6B]">B2B & Partner Hub</span>
              <h3 class="text-xl font-['Outfit',sans-serif] font-bold text-[#111827]">Brug denne anmeldelse i din butik eller webshop</h3>
            </div>
            <a href="/forhandlere" class="text-xs font-bold text-[#FF6B6B] hover:underline uppercase tracking-wider">Læs forhandler-retningslinjer &rarr;</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <!-- Pull Quote Copy Box -->
            <div class="bg-[#FFF9FA] border border-[#FFE4E8] p-6 rounded-2xl flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold uppercase tracking-widest text-gray-400">💬 Citat til Webshop & Socials</span>
                </div>
                <p class="text-sm text-gray-700 italic font-medium mb-4 bg-white p-3 rounded-xl border border-[#FFE4E8]">
                  "{pullQuote}"
                </p>
              </div>
              <button 
                data-copy={pullQuote}
                onclick="copyToClipboard(this, this.getAttribute('data-copy'))"
                class="w-full py-2.5 px-4 bg-white text-[#FF6B6B] border border-[#FF6B6B]/30 hover:bg-[#FF6B6B] hover:text-white transition-all rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2">
                📋 Kopiér Citat
              </button>
            </div>

            <!-- Embed Code Copy Box -->
            <div class="bg-[#FFF9FA] border border-[#FFE4E8] p-6 rounded-2xl flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold uppercase tracking-widest text-gray-400">💳 Embed Widget til Produktside</span>
                </div>
                <div class="bg-[#1E293B] text-gray-200 p-3 rounded-xl font-mono text-xs overflow-x-auto mb-4 border border-gray-700">
                  <code>{embedCode}</code>
                </div>
              </div>
              <button 
                data-copy={embedCode}
                onclick="copyToClipboard(this, this.getAttribute('data-copy'))"
                class="w-full py-2.5 px-4 bg-white text-gray-700 border border-gray-300 hover:bg-gray-800 hover:text-white hover:border-gray-800 transition-all rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2">
                💻 Kopiér Embed HTML
              </button>
            </div>
          </div>

          <!-- Print Neck Hanger Action -->
          <div class="bg-gradient-to-r from-[#FFF0F2] to-[#FFE0E6] border border-[#FFE4E8] p-6 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <h4 class="font-['Outfit',sans-serif] font-bold text-lg text-[#111827]">Printklart Flaske-Halsskilt (Neck Hanger)</h4>
              <p class="text-xs text-gray-600 font-medium">Print et 5x14 cm skilt til flaskens hals direkte fra browseren.</p>
            </div>
            <button 
              onclick="window.print()" 
              class="shrink-0 py-3 px-6 bg-[#FF6B6B] hover:bg-[#ff5252] text-white font-bold rounded-full shadow-md text-xs uppercase tracking-widest transition-all flex items-center gap-2">
              🖨️ Print Halsskilt (PDF)
            </button>
          </div>
        </div>
      </details>
    </div>
  </article>

  <!-- Printable Neck Hanger Element (Only visible on print) -->
  <div class="print-only hidden">
    <div class="neck-hanger-container">
      <div class="neck-hole"></div>
      <div class="brand-logo">⚡ VibeWine</div>
      <div class="score-badge">
        <span class="score-label">VIBE SCORE</span>
        <span class="score-num">{wine.data.points}</span>
      </div>
      <div class="vibe-title">{wine.data.vibe_category}</div>
      <div class="wine-name">{wine.data.title}</div>
      <div class="wine-meta">{wine.data.region} • {wine.data.vintage}</div>
      <div class="wine-price">{Math.round(wine.data.price)} kr.</div>
      <div class="footer-tag">Official Recommendation • vibewine.dk</div>
    </div>
  </div>
</Layout>

<style>
  @media screen {
    .print-only { display: none !important; }
  }
  @media print {
    body * { visibility: hidden; }
    .no-print { display: none !important; }
    .print-only, .print-only * { visibility: visible; }
    .print-only {
      display: block !important;
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
    }
    .neck-hanger-container {
      width: 55mm;
      height: 140mm;
      border: 2px dashed #FF6B6B;
      border-radius: 16px;
      padding: 10mm 4mm 4mm 4mm;
      margin: 10mm auto;
      text-align: center;
      background: #ffffff;
      box-sizing: border-box;
      position: relative;
      font-family: 'Inter', sans-serif;
    }
    .neck-hole {
      width: 30mm;
      height: 30mm;
      border: 2px dashed #FF6B6B;
      border-radius: 50%;
      margin: 0 auto 6mm auto;
    }
    .brand-logo { font-size: 14pt; font-weight: 900; color: #FF6B6B; font-family: 'Outfit', sans-serif; margin-bottom: 4mm; }
    .score-badge { background: #FFF9FA; border: 1.5pt solid #FFE4E8; border-radius: 10px; padding: 2mm; margin-bottom: 3mm; }
    .score-label { display: block; font-size: 7pt; font-weight: 900; color: #FF6B6B; letter-spacing: 1.5pt; }
    .score-num { font-size: 22pt; font-weight: 900; color: #111827; font-family: 'Outfit', sans-serif; }
    .vibe-title { font-size: 8pt; font-weight: 800; color: #FF6B6B; margin-bottom: 2mm; text-transform: uppercase; }
    .wine-name { font-size: 11pt; font-weight: 800; color: #111827; margin-bottom: 2mm; font-family: 'Outfit', sans-serif; line-height: 1.2; }
    .wine-meta { font-size: 8pt; color: #6B7280; margin-bottom: 3mm; }
    .wine-price { font-size: 16pt; font-weight: 900; color: #111827; font-family: 'Outfit', sans-serif; margin-bottom: 3mm; }
    .footer-tag { font-size: 6pt; color: #9CA3AF; text-transform: uppercase; letter-spacing: 1pt; }
  }
</style>

<script is:inline>
  function copyToClipboard(btn, text) {
    if (!navigator.clipboard) {
      alert('Kopiering understøttes ikke i denne browser.');
      return;
    }
    navigator.clipboard.writeText(text).then(() => {
      const origHTML = btn.innerHTML;
      btn.innerHTML = '✓ Kopieret til udklipsholder!';
      btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
      btn.classList.remove('text-[#FF6B6B]', 'bg-white', 'text-gray-700');
      setTimeout(() => {
        btn.innerHTML = origHTML;
        btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
        btn.classList.add('bg-white');
      }, 2000);
    }).catch(err => {
      console.error('Kopieringsfejl:', err);
    });
  }
</script>
